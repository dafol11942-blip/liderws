Options -Indexes
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
	Options +FollowSymLinks
	RewriteEngine On

	# Запрет доступа к директориям систем контроля версий (.git, .svn, .hg)
	RewriteRule (^|/)\.(git|svn|hg)(/|$) - [F,L]

	# Склейка зеркал: www.liderws.ru -> liderws.ru (один основной адрес для Google и Яндекса)
	RewriteCond %{HTTP_HOST} ^www\.liderws\.ru$ [NC]
	RewriteRule ^(.*)$ https://liderws.ru/$1 [R=301,L]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-l
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} !/bitrix/urlrewrite.php$
	RewriteRule ^(.*)$ /bitrix/urlrewrite.php [L]
	RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_headers.c>
	# Запрет отображения сайта во фрейме со стороннего домена (Clickjacking)
	Header always set X-Frame-Options "SAMEORIGIN"
	# Отключение MIME-сниффинга браузером
	Header always set X-Content-Type-Options "nosniff"
	# HSTS: принудительный https для уже работающих по https посетителей.
	# max-age задан умеренно (30 дней) и без includeSubDomains/preload —
	# чтобы не блокировать доступ, если у какого-то поддомена ещё нет TLS.
	# Увеличивайте max-age постепенно, только убедившись, что https стабилен везде.
	Header always set Strict-Transport-Security "max-age=2592000"
</IfModule>

<IfModule mod_dir.c>
	DirectoryIndex index.php index.html
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive on
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/gif "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType image/x-icon "access plus 30 days"
	ExpiresByType font/woff2 "access plus 1 year"
	# style.css подключается с ?v=<filemtime> — кэш сбрасывается сам при каждом изменении
	ExpiresByType text/css "access plus 30 days"
	# main.js/favorites.js подключаются без версии — держим недолго, чтобы правки доходили до посетителей
	ExpiresByType application/javascript "access plus 1 day"
	ExpiresByType text/javascript "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/ld+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
	AddType font/woff2 .woff2
	AddType image/webp .webp
	AddType text/plain .txt
	AddCharset utf-8 .txt .xml
</IfModule>